# Connections each worker keeps open for the public API. Three workers share
# the database, so this is per worker, not per deployment.
API_POOL_MAX=

# Where this process answers its own API, in cleartext, from inside the
# container. Optional: the addresses are tried in order (HOSTNAME, both
# loopbacks, then the host the request arrived on) and the one that answers is
# kept. Set this only to skip the search, and never to the public name, because
# that one reaches the edge and the edge speaks TLS.
ULOGGD_INTERNAL_ORIGIN=
