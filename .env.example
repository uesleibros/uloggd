NEXT_PUBLIC_SITE_URL=
# Optional email overrides. Defaults use the configured site's hostname.
CONTACT_EMAIL=
SUPPORT_EMAIL=
DATABASE_URL=
DIRECT_URL=
# Optional shared acceleration for public IGDB answers. Never use NEXT_PUBLIC_.
REDIS_URL=
# Square Cloud uses its own TLS certificate. Paste the trusted certificate from
# the database dashboard, or point at a deployed certificate file. Keep TLS verified.
REDIS_CA_CERT=
REDIS_CA_CERT_PATH=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
STEAM_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SQUARE_BLOB_ENDPOINT=https://s3-blob.squarecloud.app
SQUARE_BLOB_REGION=auto
SQUARE_BLOB_BUCKET=public
SQUARE_BLOB_ACCESS_KEY_ID=
SQUARE_BLOB_SECRET_ACCESS_KEY=
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.uloggd.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
PUSH_DISPATCH_SECRET=
BACKLOGGD_PARTNER_USER_AGENT=
BACKLOGGD_PARTNER_HEADER_NAME=
BACKLOGGD_PARTNER_HEADER_VALUE=

# Connections each worker keeps open for the public API. Three workers share
# the database, so this is per worker, not per deployment.
API_POOL_MAX=

# Where this process answers its own API, in cleartext, from inside the
# container. Optional: the addresses are tried in order (HOSTNAME, both
# loopbacks, then the host the request arrived on) and the one that answers is
# kept. Set this only to skip the search, and never to the public name, because
# that one reaches the edge and the edge speaks TLS.
ULOGGD_INTERNAL_ORIGIN=

# Requests per second for these credentials, shared by the primary across all
# workers. The deployment never exceeds IGDB's four-request budget.
IGDB_REQUESTS_PER_SECOND=
