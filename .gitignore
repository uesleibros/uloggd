# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# square cloud deploy artefacts
/square-deploy/
/square-deploy.zip

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local state
/.claude/
.source

# A screenshot written to a path built from an environment variable that was
# not set lands here, which is how two of them were once committed.
/undefined/

# Python bytecode from scripts/
__pycache__/
